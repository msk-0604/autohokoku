# ===== 基本 =====
# 公開URL（メール内リンク・Stripe の戻り先・OGP に使用）。本番は https://...
APP_URL=http://localhost:3000

# ===== データベース・ファイル保存 =====
# 本番: worker（Cloudflare Worker 経由で D1 / R2）。ローカル: sqlite / local
DB_DRIVER=sqlite
DATABASE_PATH=.data/dev.sqlite
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# 本番のみ：workers/gateway をデプロイした URL と共有シークレット（32文字以上のランダム文字列）
GATEWAY_URL=
GATEWAY_SECRET=

# ===== メール（Resend） =====
# 本番: resend / ローカル: log（.data/outbox に書き出すだけで送信しない）
EMAIL_DRIVER=log
RESEND_API_KEY=
# Resend で認証済みのドメインのアドレス
EMAIL_FROM="Stark Report <no-reply@your-domain.jp>"
EMAIL_REPLY_TO=

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Stripe Tax を有効にする場合 true（価格は税込設定のため表示額は変わらない）
STRIPE_AUTOMATIC_TAX=false
# 本番キー（sk_live_）を使うときだけ true にする（誤って本番決済を有効化しないための安全装置）
STRIPE_LIVE_MODE_CONFIRMED=false

# ===== 運営・監視 =====
# Vercel Cron の認証（Vercel が自動で Authorization: Bearer $CRON_SECRET を付ける）
CRON_SECRET=
# 重大エラー・日次監視の通知先
ADMIN_ALERT_EMAIL=
# お問い合わせの通知先（未設定なら ADMIN_ALERT_EMAIL）
SUPPORT_EMAIL=
TRIAL_DAYS=14

# ===== 公開側（ブラウザに公開される値） =====
# Google Analytics 4 の測定ID（G-XXXXXXX）。未設定なら読み込まない
NEXT_PUBLIC_GA_ID=
# Google Search Console の HTML タグ認証の content 値
NEXT_PUBLIC_GSC_VERIFICATION=
